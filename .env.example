# OpenAI (API key is required)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4000
OPENAI_REQUEST_TIMEOUT_SECONDS=120

# Database and persistent backend data
DATABASE_URL=sqlite:///./backend/app/data/app.db
DATA_DIR=./backend/app/data

# Redis and RQ
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
RQ_QUEUE_NAME=repo-analysis
PREPROCESSING_JOB_TIMEOUT_SECONDS=1800
ANALYSIS_JOB_TIMEOUT_SECONDS=7200
JOB_RETRY_MAX=2
JOB_RETRY_INTERVAL_SECONDS=30

# API server and exact Next.js browser origins (comma-separated)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Repository ingestion byte limits
MAX_UPLOAD_ZIP_BYTES=104857600
MAX_EXTRACTED_TOTAL_BYTES=524288000
MAX_EXTRACTED_FILE_BYTES=52428800

# Repository ingestion counts and timeouts
MAX_EXTRACTED_FILES=10000
MAX_ZIP_COMPRESSION_RATIO=200
REPOSITORY_CLONE_TIMEOUT_SECONDS=120
GITHUB_VALIDATION_TIMEOUT_SECONDS=10
